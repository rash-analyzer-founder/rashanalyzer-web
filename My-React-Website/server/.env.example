# Example env for local development
PORT=4000
# Optional: provide your own RSA private key (PEM). If omitted, the server will generate one on startup.
#JWT_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Or specify a PEM file path instead of embedding the private key directly:
#JWT_PRIVATE_KEY_PATH=./jwt-private-key.pem
# Optional HTTPS support for local development.
#HTTPS_KEY_PATH=./localhost-key.pem
#HTTPS_CERT_PATH=./localhost-cert.pem
ACCESS_TOKEN_EXPIRES_SECONDS=900
REFRESH_TOKEN_EXPIRES_SECONDS=604800
